{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cargate",
  "account_id": "d29db89a330417194726eb69450a4668",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "issues": { "enabled": true },
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cargate-offers",
      "database_id": "50fde2d6-d2f2-4607-9961-729b462b115b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "cargate-images" }
  ],
  "ratelimits": [
    { "name": "SEARCH_RATE_LIMITER", "namespace_id": "9404321", "simple": { "limit": 3, "period": 60 } }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ENABLE_MOCK_SOURCE": "false",
    "ENABLE_INDEXED_SEARCH": "true"
  }
}
